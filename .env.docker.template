############
# URLs / ports
############

POSTGRES_DB="postgres"
POSTGRES_PORT="5432"

KONG_HTTP_PORT="8000"
APP_PORT="3000"
STUDIO_PORT="54323"

SITE_URL="http://localhost:3000"
API_EXTERNAL_URL="http://localhost:8000/auth/v1"
SUPABASE_PUBLIC_URL="http://localhost:8000"

# What the browser and the app server both use to reach Supabase (via Kong).
VITE_SUPABASE_URL="http://localhost:8000"

############
# Auth behavior
############

DISABLE_SIGNUP="false"
ENABLE_EMAIL_SIGNUP="true"
# Local dev: skip email confirmation so sign-up works without SMTP configured.
ENABLE_EMAIL_AUTOCONFIRM="true"
ENABLE_ANONYMOUS_USERS="false"
ADDITIONAL_REDIRECT_URLS=""

# Optional: uncomment + set to enable Google sign-in, and uncomment the
# matching GOTRUE_EXTERNAL_GOOGLE_* lines in docker-compose.yml.
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=

############
